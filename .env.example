# 复制本文件为 .env，并填入真实值；.env 已被 git 忽略，切勿提交。
# 生成强密码：python -c 'import secrets; print(secrets.token_urlsafe(24))'

# DeepSeek 模型配置
LLM_API_KEY=在这里填入你的DeepSeek_API_Key
# 与代码和 Compose 默认值一致；可替换为账号实际可调用的模型 ID。
LLM_API_ID=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
# 可选设置（默认值与 app/core/config.py、compose.yaml 一致）
LLM_THINKING=disabled
LLM_TIMEOUT_SECONDS=60
LLM_REQUEST_DEADLINE_SECONDS=180
LLM_NETWORK_RETRIES=1
LLM_MAX_CALLS=6
LLM_MAX_OUTPUT_TOKENS=1800
LLM_PROMPT_TOKEN_BUDGET=24000
LLM_REQUEST_TOKEN_BUDGET=50000

# 本地开发数据库（本机 PostgreSQL，非 Docker 部署时使用）
DATABASE_URL=postgresql://agent_reader:本地只读账号密码@localhost:5432/agent_db
SESSION_DATABASE_URL=postgresql://agent_session_writer:本地会话写入账号密码@localhost:5432/agent_db

# Docker Compose 部署（三个密码各不同）
# 必须将下方占位符替换为 URL 安全随机密码；首次部署详见 docs/quickstart.md。
DOCKER_POSTGRES_PASSWORD=生成一个强密码
DOCKER_READER_PASSWORD=再生成一个强密码
DOCKER_SESSION_PASSWORD=第三个强密码

# 本机访问端口（保持仅绑定 127.0.0.1）
DOCKER_APP_PORT=8001
DOCKER_UI_PORT=8501
